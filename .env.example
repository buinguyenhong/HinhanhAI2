# Required server-only Vercel Environment Variables. Do not prefix these with VITE_.
APP_PASSWORD="replace-with-a-long-unique-password"
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-random-48-byte-secret"
GEMINI_API_KEY="your-gemini-api-key"

# Required only for Google Drive OAuth. Set the callback URI to:
# https://your-production-domain/api/google-drive/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
