# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_PASSWORD: Mật khẩu bảo vệ ứng dụng phía server (không bị lộ trên client bundle)
APP_PASSWORD="admin"

# JWT_SECRET: Khóa bí mật ký JWT session token cho các yêu cầu API
JWT_SECRET="hinhanhai-production-secure-jwt-secret-key-2026"

# OPENAI_ALLOWED_DOMAINS: Danh sách các tên miền API OpenAI/tương thích được phép gọi (ngăn chặn SSRF)
OPENAI_ALLOWED_DOMAINS="api.openai.com,api.together.xyz,api.groq.com,openrouter.ai"

# RATE LIMITING CẤU HÌNH (Tùy chọn)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
AI_RATE_LIMIT_MAX=20
