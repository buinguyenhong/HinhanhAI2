# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_PASSWORD: Mật khẩu bảo vệ ứng dụng phía server (không bị lộ trên client bundle)
APP_PASSWORD="admin"

# JWT_SECRET: Khóa bí mật ký JWT session token cho các yêu cầu API
JWT_SECRET="hinhanhai-production-secure-jwt-secret-key-2026"

# OPENAI_ALLOWED_DOMAINS: (LEGACY — không còn dùng để chặn SSRF).
# Hiện tại endpoint OpenAI-compatible tự do (chỉ check URL hợp lệ).
# Người dùng tự chịu trách nhiệm chọn endpoint tin cậy.
# OPENAI_ALLOWED_DOMAINS="api.openai.com,api.together.xyz,api.groq.com,openrouter.ai"

# RATE LIMITING CẤU HÌNH (Tùy chọn)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
AI_RATE_LIMIT_MAX=20

# ANALYZE_NORMALIZER_ENABLED: Bật/tắt server-side LLM normalizer cho response phân tích ảnh.
# Khi model/proxy trả JSON sai schema (VD: 1endpoint.dev trả overallArtStyleAesthetic...),
# server sẽ gọi Gemini flash-lite để map về schema chuẩn. Tốn thêm 1 API call + latency.
# Mặc định: true. Đặt 'false' để tắt (client vẫn có alias fallback).
# ANALYZE_NORMALIZER_ENABLED=true

# SYNC_DATA_FILE: Đường dẫn file JSON đồng bộ cài đặt + lịch sử giữa các máy.
# Mặc định: ./data/sync-store.json (tương đối theo thư mục chạy server).
# ⚠️ Render free tier có ổ đĩa EPHEMERAL — dữ liệu mất khi redeploy/restart.
# Nếu muốn giữ dữ liệu bền vững, hãy gắn Persistent Disk (Render) và trỏ tới đó, vd:
# SYNC_DATA_FILE="/var/data/sync-store.json"
# SYNC_DATA_FILE="./data/sync-store.json"
